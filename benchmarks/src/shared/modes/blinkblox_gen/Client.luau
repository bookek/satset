	local ARRAY_START_1 = Allocate(12 * #Value)
	for Index = 1, #Value do
		local Item_1 = Value[Index]
		-- Item_1: Vectors
		local Vector = Item_1
		-- Allocate 4
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_0, Vector.X)
		-- Allocate 4
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_1, Vector.Y)
		-- Allocate 4
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 4
		buffer.writef32(SendBuffer, OPERATION_OFFSET_2, Vector.Z)
	end
	-- END ARRAY
end

function SerdesFunctions.WriteEVENT_Strings(Value: { string }): ()
	-- Allocate BLOCK: 1 bytes
	local BLOCK_START = Allocate(1)
	-- EVENT_Strings (3)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 3)
	-- Value: Strings
	-- START ARRAY
	if not (#Value <= 65535) then error(`Expected "#Value" to be smaller than or equal to 65535, got {#Value} instead.`) end
	WriteVarLength(#Value)
		-- Allocate BLOCK: 1 bytes
	local ARRAY_START_1 = Allocate(1 * #Value)
	for Index = 1, #Value do
		local Item_1 = Value[Index]
		-- Item_1: Strings
		local Length = #Item_1
		if not (Length <= 32) then error(`Expected "Length" to be smaller than or equal to 32, got {Length} instead.`) end
		-- Allocate 1
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 1
		buffer.writeu8(SendBuffer, OPERATION_OFFSET_0, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Item_1, Length)
	end
	-- END ARRAY
end

function SerdesFunctions.WriteEVENT_Mixed(Value: { id: number, health: number, position: Vector3, velocity: Vector3, name: string, isRunning: boolean, animation: number, team: number }): ()
	-- Allocate BLOCK: 31 bytes
	local BLOCK_START = Allocate(31)
	local BITFIELD_1_0
	-- EVENT_Mixed (4)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 4)
	-- Value: Mixed
	-- Value.id: id
	buffer.writeu8(SendBuffer, BLOCK_START + 1, Value.id)
	-- Value.health: health
	buffer.writeu8(SendBuffer, BLOCK_START + 2, Value.health)
	do
		-- Value.position: position
		local Vector = Value.position
		buffer.writef32(SendBuffer, BLOCK_START + 3, Vector.X)
		buffer.writef32(SendBuffer, BLOCK_START + 7, Vector.Y)
		buffer.writef32(SendBuffer, BLOCK_START + 11, Vector.Z)
	end
	do
		-- Value.velocity: velocity
		local Vector = Value.velocity
		buffer.writef32(SendBuffer, BLOCK_START + 15, Vector.X)
		buffer.writef32(SendBuffer, BLOCK_START + 19, Vector.Y)
		buffer.writef32(SendBuffer, BLOCK_START + 23, Vector.Z)
	end
	do
		-- Value.name: name
		local Length = #Value.name
		if not (Length <= 32) then error(`Expected "Length" to be smaller than or equal to 32, got {Length} instead.`) end
		buffer.writeu8(SendBuffer, BLOCK_START + 27, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.name, Length)
	end
	-- Value.isRunning: isRunning
	BITFIELD_1_0 = 0
	if Value.isRunning then BITFIELD_1_0 += 0x01 end
	-- Value.animation: animation
	buffer.writeu8(SendBuffer, BLOCK_START + 29, Value.animation)
	-- Value.team: team
	buffer.writeu8(SendBuffer, BLOCK_START + 30, Value.team)
	buffer.writeu8(SendBuffer, BLOCK_START + 28, BITFIELD_1_0)
end

function SerdesFunctions.WriteEVENT_SingleValue(Value: number): ()
	-- Allocate BLOCK: 2 bytes
	local BLOCK_START = Allocate(2)
	-- EVENT_SingleValue (5)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 5)
	-- Value: SingleValue
	buffer.writeu8(SendBuffer, BLOCK_START + 1, Value)
end

